# The server reads exported process variables. npm start does not auto-load .env.
# Local demo uses generated private files under .local; no external credentials required.
NODE_ENV=development
# PUBLIC_ORIGIN: exact forwarded browser origin if different from localhost:5001.
# DATABASE_URL: optional external PostgreSQL connection; omit for .local/database.json.
# DATA_ENCRYPTION_KEY: optional 64 hex characters (32 bytes); keep secret and stable.
# Without a configured key, development generates .local/encryption.key. Production requires it.
# FEATURE_ADMIN=false
# FEATURE_CHAT=false
# FEATURE_AMBIENT_NPC=false
# Development enables the above modules unless explicitly false.
# Production disables them unless explicitly true. Mock LIVE stays disabled in production.
# DEMO_IMPORT_ENABLED=false
# Internal game port remains 5001; local DB binds only 127.0.0.1:55432.
